[
  { "id": "en-intermedio-04-w01", "en": "would", "es": "-ría (condicional)", "pron": "úd", "tipo": "verbo",
    "ejemplo": { "en": "I would love to work with you.", "es": "Me encantaría trabajar contigo." } },
  { "id": "en-intermedio-04-w02", "en": "would you mind...?", "es": "¿te molestaría...?", "pron": "úyu máind", "tipo": "expresion",
    "ejemplo": { "en": "Would you mind checking my code?", "es": "¿Te molestaría revisar mi código?" } },
  { "id": "en-intermedio-04-w03", "en": "I'd rather", "es": "preferiría", "pron": "áid rázer", "tipo": "expresion",
    "ejemplo": { "en": "I'd rather work from home today.", "es": "Hoy preferiría trabajar desde casa." } },
  { "id": "en-intermedio-04-w04", "en": "if I were you", "es": "yo que tú / en tu lugar", "pron": "if ái uér iú", "tipo": "expresion",
    "ejemplo": { "en": "If I were you, I'd take the job.", "es": "Yo que tú, aceptaría el trabajo." } },
  { "id": "en-intermedio-04-w05", "en": "what would you do if...?", "es": "¿qué harías si...?", "pron": "uát úyu dú if", "tipo": "expresion",
    "ejemplo": { "en": "What would you do if you missed a deadline?", "es": "¿Qué harías si no cumplieras una fecha de entrega?" } },
  { "id": "en-intermedio-04-w06", "en": "I wish", "es": "ojalá / me gustaría que", "pron": "ái uísh", "tipo": "expresion",
    "ejemplo": { "en": "I wish I spoke English better.", "es": "Ojalá hablara mejor inglés." } },
  { "id": "en-intermedio-04-w07", "en": "suppose", "es": "suponer", "pron": "sopóus", "tipo": "verbo",
    "ejemplo": { "en": "Suppose the server goes down. What would you do?", "es": "Supón que se cae el servidor. ¿Qué harías?" } },
  { "id": "en-intermedio-04-w08", "en": "hypothetical", "es": "hipotético", "pron": "jaipozétikol", "tipo": "adjetivo",
    "ejemplo": { "en": "Let me ask you a hypothetical question.", "es": "Déjame hacerte una pregunta hipotética." } },
  { "id": "en-intermedio-04-w09", "en": "scenario", "es": "escenario / caso", "pron": "sinério", "tipo": "sustantivo",
    "ejemplo": { "en": "In that scenario, I'd call the client.", "es": "En ese caso, llamaría al cliente." } },
  { "id": "en-intermedio-04-w10", "en": "afford", "es": "poder pagar / permitirse", "pron": "afórd", "tipo": "verbo",
    "ejemplo": { "en": "I can't afford a new laptop right now.", "es": "Ahora no me alcanza para una laptop nueva." } },
  { "id": "en-intermedio-04-w11", "en": "lottery", "es": "lotería", "pron": "láteri", "tipo": "sustantivo",
    "ejemplo": { "en": "If I won the lottery, I'd buy a house.", "es": "Si ganara la lotería, compraría una casa." } },
  { "id": "en-intermedio-04-w12", "en": "salary", "es": "sueldo / salario", "pron": "sáleri", "tipo": "sustantivo",
    "ejemplo": { "en": "The salary for this job is good.", "es": "El sueldo de este trabajo es bueno." } },
  { "id": "en-intermedio-04-w13", "en": "raise", "es": "aumento de sueldo", "pron": "réis", "tipo": "sustantivo",
    "ejemplo": { "en": "She asked her boss for a raise.", "es": "Ella le pidió un aumento a su jefe." } },
  { "id": "en-intermedio-04-w14", "en": "promotion", "es": "ascenso", "pron": "promóushon", "tipo": "sustantivo",
    "ejemplo": { "en": "He got a promotion after two years.", "es": "Lo ascendieron después de dos años." } },
  { "id": "en-intermedio-04-w15", "en": "relocate", "es": "mudarse (por trabajo)", "pron": "rilóukeit", "tipo": "verbo",
    "ejemplo": { "en": "Would you relocate for this job?", "es": "¿Te mudarías por este trabajo?" } },
  { "id": "en-intermedio-04-w16", "en": "startup", "es": "empresa emergente (startup)", "pron": "stártap", "tipo": "sustantivo",
    "ejemplo": { "en": "She works at a small startup.", "es": "Ella trabaja en una startup pequeña." } },
  { "id": "en-intermedio-04-w17", "en": "choice", "es": "elección / opción", "pron": "chóis", "tipo": "sustantivo",
    "ejemplo": { "en": "It was a difficult choice.", "es": "Fue una elección difícil." } },
  { "id": "en-intermedio-04-w18", "en": "option", "es": "opción", "pron": "ápshon", "tipo": "sustantivo",
    "ejemplo": { "en": "We have two options.", "es": "Tenemos dos opciones." } },
  { "id": "en-intermedio-04-w19", "en": "decision", "es": "decisión", "pron": "disíshon", "tipo": "sustantivo",
    "ejemplo": { "en": "I made a decision last night.", "es": "Tomé una decisión anoche." } },
  { "id": "en-intermedio-04-w20", "en": "risk", "es": "riesgo", "pron": "rísk", "tipo": "sustantivo",
    "ejemplo": { "en": "Changing jobs is always a risk.", "es": "Cambiar de trabajo siempre es un riesgo." } },
  { "id": "en-intermedio-04-w21", "en": "opportunity", "es": "oportunidad", "pron": "aportúniti", "tipo": "sustantivo",
    "ejemplo": { "en": "This internship is a great opportunity.", "es": "Estas prácticas son una gran oportunidad." } },
  { "id": "en-intermedio-04-w22", "en": "honestly", "es": "sinceramente", "pron": "ónestli", "tipo": "adverbio",
    "ejemplo": { "en": "Honestly, I don't know the answer.", "es": "Sinceramente, no sé la respuesta." } },
  { "id": "en-intermedio-04-w23", "en": "politely", "es": "con educación / amablemente", "pron": "poláitli", "tipo": "adverbio",
    "ejemplo": { "en": "Always ask politely for help.", "es": "Siempre pide ayuda con educación." } },
  { "id": "en-intermedio-04-w24", "en": "lend a hand", "es": "echar una mano", "pron": "lénd a jánd", "tipo": "expresion",
    "ejemplo": { "en": "Could you lend me a hand with this?", "es": "¿Me echas una mano con esto?" } },
  { "id": "en-intermedio-04-w25", "en": "appreciate", "es": "agradecer / valorar", "pron": "aprísheit", "tipo": "verbo",
    "ejemplo": { "en": "I really appreciate your help.", "es": "De verdad agradezco tu ayuda." } },
  { "id": "en-intermedio-04-w26", "en": "it would be great if...", "es": "sería genial si...", "pron": "it úd bi gréit if", "tipo": "expresion",
    "ejemplo": { "en": "It would be great if you could join us.", "es": "Sería genial si pudieras acompañarnos." } },
  { "id": "en-intermedio-04-w27", "en": "would you like...?", "es": "¿te gustaría...? / ¿quieres...?", "pron": "úyu láik", "tipo": "expresion",
    "ejemplo": { "en": "Would you like some coffee?", "es": "¿Quieres un café?" } },
  { "id": "en-intermedio-04-w28", "en": "in your shoes", "es": "en tu lugar", "pron": "in iór shúz", "tipo": "expresion",
    "ejemplo": { "en": "In your shoes, I'd say yes.", "es": "En tu lugar, diría que sí." } },
  { "id": "en-intermedio-04-w29", "en": "approach", "es": "enfoque / forma de abordar", "pron": "apróuch", "tipo": "sustantivo",
    "ejemplo": { "en": "I'd use a different approach.", "es": "Yo usaría otro enfoque." } },
  { "id": "en-intermedio-04-w30", "en": "overtime", "es": "horas extra", "pron": "óuvertaim", "tipo": "sustantivo",
    "ejemplo": { "en": "I wouldn't work overtime every week.", "es": "No haría horas extra todas las semanas." } },
  { "id": "en-intermedio-04-w31", "en": "rewrite", "es": "reescribir", "pron": "riráit", "tipo": "verbo", "formas": { "pasado": "rewrote", "participio": "rewritten" },
    "ejemplo": { "en": "We rewrote the whole module last year.", "es": "Reescribimos todo el módulo el año pasado." } },
  { "id": "en-intermedio-04-w32", "en": "from scratch", "es": "desde cero", "pron": "from skrách", "tipo": "expresion",
    "ejemplo": { "en": "I built this app from scratch.", "es": "Hice esta app desde cero." } },
  { "id": "en-intermedio-04-w33", "en": "budget", "es": "presupuesto", "pron": "bádyet", "tipo": "sustantivo",
    "ejemplo": { "en": "The project has a small budget.", "es": "El proyecto tiene un presupuesto pequeño." } },
  { "id": "en-intermedio-04-w34", "en": "unlimited", "es": "ilimitado", "pron": "anlímited", "tipo": "adjetivo",
    "ejemplo": { "en": "If I had unlimited time, I'd learn everything.", "es": "Si tuviera tiempo ilimitado, aprendería todo." } },
  { "id": "en-intermedio-04-w35", "en": "tool", "es": "herramienta", "pron": "túl", "tipo": "sustantivo",
    "ejemplo": { "en": "Git is my favorite tool.", "es": "Git es mi herramienta favorita." } }
]
