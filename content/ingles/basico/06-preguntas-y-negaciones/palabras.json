[
  { "id": "en-basico-06-w01", "en": "what", "es": "qué / cuál", "pron": "uát", "tipo": "pronombre",
    "ejemplo": { "en": "What do you do?", "es": "¿A qué te dedicas?" } },
  { "id": "en-basico-06-w02", "en": "where", "es": "dónde", "pron": "uér", "tipo": "adverbio",
    "ejemplo": { "en": "Where do you live?", "es": "¿Dónde vives?" } },
  { "id": "en-basico-06-w03", "en": "when", "es": "cuándo", "pron": "uén", "tipo": "adverbio",
    "ejemplo": { "en": "When does the class start?", "es": "¿Cuándo empieza la clase?" } },
  { "id": "en-basico-06-w04", "en": "who", "es": "quién", "pron": "jú", "tipo": "pronombre",
    "ejemplo": { "en": "Who is your teacher?", "es": "¿Quién es tu profesor?" } },
  { "id": "en-basico-06-w05", "en": "why", "es": "por qué", "pron": "uái", "tipo": "adverbio",
    "ejemplo": { "en": "Why do you study English?", "es": "¿Por qué estudias inglés?" } },
  { "id": "en-basico-06-w06", "en": "how", "es": "cómo", "pron": "jáu", "tipo": "adverbio",
    "ejemplo": { "en": "How do you go to work?", "es": "¿Cómo vas al trabajo?" } },
  { "id": "en-basico-06-w07", "en": "which", "es": "cuál (entre opciones)", "pron": "uích", "tipo": "pronombre",
    "ejemplo": { "en": "Which one do you want?", "es": "¿Cuál quieres?" } },
  { "id": "en-basico-06-w08", "en": "how much", "es": "cuánto", "pron": "jáu mách", "tipo": "expresion",
    "ejemplo": { "en": "How much does it cost?", "es": "¿Cuánto cuesta?" } },
  { "id": "en-basico-06-w09", "en": "how many", "es": "cuántos", "pron": "jáu méni", "tipo": "expresion",
    "ejemplo": { "en": "How many people work here?", "es": "¿Cuántas personas trabajan aquí?" } },
  { "id": "en-basico-06-w10", "en": "how often", "es": "cada cuánto, con qué frecuencia", "pron": "jáu ófen", "tipo": "expresion",
    "ejemplo": { "en": "How often do you read?", "es": "¿Cada cuánto lees?" } },
  { "id": "en-basico-06-w11", "en": "how long", "es": "cuánto tiempo", "pron": "jáu lóng", "tipo": "expresion",
    "ejemplo": { "en": "How long is the meeting?", "es": "¿Cuánto dura la reunión?" } },
  { "id": "en-basico-06-w12", "en": "What about you?", "es": "¿Y tú?", "pron": "uát abáut iú", "tipo": "expresion",
    "ejemplo": { "en": "I live in Lima. What about you?", "es": "Vivo en Lima. ¿Y tú?" } },
  { "id": "en-basico-06-w13", "en": "what kind of", "es": "qué tipo de", "pron": "uát káind ov", "tipo": "expresion",
    "ejemplo": { "en": "What kind of music do you like?", "es": "¿Qué tipo de música te gusta?" } },
  { "id": "en-basico-06-w14", "en": "because", "es": "porque", "pron": "bicós", "tipo": "conector",
    "ejemplo": { "en": "I study English because I need it.", "es": "Estudio inglés porque lo necesito." } },
  { "id": "en-basico-06-w15", "en": "don't", "es": "no (con I, you, we, they)", "pron": "dóunt", "tipo": "expresion",
    "ejemplo": { "en": "I don't work on Sundays.", "es": "No trabajo los domingos." } },
  { "id": "en-basico-06-w16", "en": "doesn't", "es": "no (con he, she, it)", "pron": "dásent", "tipo": "expresion",
    "ejemplo": { "en": "She doesn't speak French.", "es": "Ella no habla francés." } },
  { "id": "en-basico-06-w17", "en": "Yes, I do.", "es": "Sí (respuesta corta)", "pron": "iés, ái dú", "tipo": "expresion",
    "ejemplo": { "en": "Do you like React? Yes, I do.", "es": "¿Te gusta React? Sí." } },
  { "id": "en-basico-06-w18", "en": "No, I don't.", "es": "No (respuesta corta)", "pron": "nóu, ái dóunt", "tipo": "expresion",
    "ejemplo": { "en": "Do you drink coffee? No, I don't.", "es": "¿Tomas café? No." } },
  { "id": "en-basico-06-w19", "en": "Yes, she does.", "es": "Sí (respuesta corta con he, she, it)", "pron": "iés, shí dás", "tipo": "expresion",
    "ejemplo": { "en": "Does Ana work here? Yes, she does.", "es": "¿Ana trabaja aquí? Sí." } },
  { "id": "en-basico-06-w20", "en": "No, he doesn't.", "es": "No (respuesta corta con he, she, it)", "pron": "nóu, jí dásent", "tipo": "expresion",
    "ejemplo": { "en": "Does Tom speak Spanish? No, he doesn't.", "es": "¿Tom habla español? No." } },
  { "id": "en-basico-06-w21", "en": "wonder", "es": "preguntarse", "pron": "uánder", "tipo": "verbo",
    "ejemplo": { "en": "I wonder why he doesn't call.", "es": "Me pregunto por qué no llama." } },
  { "id": "en-basico-06-w22", "en": "mind", "es": "importar, molestar / mente", "pron": "máind", "tipo": "verbo",
    "ejemplo": { "en": "I don't mind the noise.", "es": "No me molesta el ruido." } },
  { "id": "en-basico-06-w23", "en": "example", "es": "ejemplo", "pron": "eksámpol", "tipo": "sustantivo",
    "ejemplo": { "en": "Can you give me an example?", "es": "¿Me puedes dar un ejemplo?" } },
  { "id": "en-basico-06-w24", "en": "care", "es": "importar (a alguien) / cuidado", "pron": "kér", "tipo": "verbo",
    "ejemplo": { "en": "I don't care about the color.", "es": "No me importa el color." } },
  { "id": "en-basico-06-w25", "en": "matter", "es": "importar, tener importancia / asunto", "pron": "máter", "tipo": "verbo",
    "ejemplo": { "en": "It doesn't matter.", "es": "No importa." } },
  { "id": "en-basico-06-w26", "en": "translate", "es": "traducir", "pron": "tránsleit", "tipo": "verbo",
    "ejemplo": { "en": "I don't translate every word.", "es": "No traduzco cada palabra." } },
  { "id": "en-basico-06-w27", "en": "mean", "es": "significar / querer decir", "pron": "mín", "tipo": "verbo",
    "formas": { "pasado": "meant", "participio": "meant" },
    "ejemplo": { "en": "What does this word mean?", "es": "¿Qué significa esta palabra?" } },
  { "id": "en-basico-06-w28", "en": "pronounce", "es": "pronunciar", "pron": "pronáuns", "tipo": "verbo",
    "ejemplo": { "en": "How do you pronounce this word?", "es": "¿Cómo se pronuncia esta palabra?" } },
  { "id": "en-basico-06-w29", "en": "doubt", "es": "dudar (de que algo sea cierto)", "pron": "dáut", "tipo": "verbo",
    "ejemplo": { "en": "Is it free? I doubt it.", "es": "¿Es gratis? Lo dudo." } },
  { "id": "en-basico-06-w30", "en": "difference", "es": "diferencia", "pron": "díferens", "tipo": "sustantivo",
    "ejemplo": { "en": "What's the difference?", "es": "¿Cuál es la diferencia?" } },
  { "id": "en-basico-06-w31", "en": "information", "es": "información", "pron": "informéishon", "tipo": "sustantivo",
    "ejemplo": { "en": "I need more information.", "es": "Necesito más información." } },
  { "id": "en-basico-06-w32", "en": "either", "es": "tampoco (al final de una frase negativa)", "pron": "íder", "tipo": "adverbio",
    "ejemplo": { "en": "She doesn't eat meat. I don't either.", "es": "Ella no come carne. Yo tampoco." } },
  { "id": "en-basico-06-w33", "en": "nothing", "es": "nada", "pron": "názing", "tipo": "pronombre",
    "ejemplo": { "en": "I know nothing about Java.", "es": "No sé nada de Java." } },
  { "id": "en-basico-06-w34", "en": "nobody", "es": "nadie", "pron": "nóubodi", "tipo": "pronombre",
    "ejemplo": { "en": "Nobody knows the answer.", "es": "Nadie sabe la respuesta." } },
  { "id": "en-basico-06-w35", "en": "what else", "es": "qué más", "pron": "uát éls", "tipo": "expresion",
    "ejemplo": { "en": "What else do you need?", "es": "¿Qué más necesitas?" } },
  { "id": "en-basico-06-w36", "en": "how far", "es": "qué tan lejos, a qué distancia", "pron": "jáu fár", "tipo": "expresion",
    "ejemplo": { "en": "How far is your office?", "es": "¿Qué tan lejos está tu oficina?" } },
  { "id": "en-basico-06-w37", "en": "what for", "es": "para qué", "pron": "uát fór", "tipo": "expresion",
    "ejemplo": { "en": "What do you need it for?", "es": "¿Para qué lo necesitas?" } },
  { "id": "en-basico-06-w38", "en": "how about", "es": "qué tal, y si", "pron": "jáu abáut", "tipo": "expresion",
    "ejemplo": { "en": "How about Friday?", "es": "¿Qué tal el viernes?" } },
  { "id": "en-basico-06-w39", "en": "Why not?", "es": "¿Por qué no?", "pron": "uái nót", "tipo": "expresion",
    "ejemplo": { "en": "He doesn't work on Fridays. Why not?", "es": "Él no trabaja los viernes. ¿Por qué no?" } },
  { "id": "en-basico-06-w40", "en": "How come?", "es": "¿Cómo así?, ¿por qué?", "pron": "jáu kám", "tipo": "expresion",
    "ejemplo": { "en": "She doesn't like coffee? How come?", "es": "¿No le gusta el café? ¿Cómo así?" } },
  { "id": "en-basico-06-w41", "en": "It depends.", "es": "Depende.", "pron": "it dipénds", "tipo": "expresion",
    "ejemplo": { "en": "Do you work late? It depends.", "es": "¿Trabajas hasta tarde? Depende." } },
  { "id": "en-basico-06-w42", "en": "Pardon?", "es": "¿Perdón?, ¿cómo? (para que repitan)", "pron": "párdon", "tipo": "expresion",
    "ejemplo": { "en": "Pardon? I don't hear you.", "es": "¿Perdón? No te escucho." } },
  { "id": "en-basico-06-w43", "en": "explain", "es": "explicar", "pron": "ekspléin", "tipo": "verbo",
    "ejemplo": { "en": "Can you explain this part?", "es": "¿Puedes explicar esta parte?" } },
  { "id": "en-basico-06-w44", "en": "repeat", "es": "repetir", "pron": "ripít", "tipo": "verbo",
    "ejemplo": { "en": "Can you repeat that, please?", "es": "¿Puedes repetir eso, por favor?" } },
  { "id": "en-basico-06-w45", "en": "spell", "es": "deletrear, escribir letra por letra", "pron": "spél", "tipo": "verbo",
    "ejemplo": { "en": "How do you spell your last name?", "es": "¿Cómo se escribe tu apellido?" } },
  { "id": "en-basico-06-w46", "en": "agree", "es": "estar de acuerdo", "pron": "agrí", "tipo": "verbo",
    "ejemplo": { "en": "I don't agree with you.", "es": "No estoy de acuerdo contigo." } },
  { "id": "en-basico-06-w47", "en": "hope", "es": "esperar (desear) / esperanza", "pron": "jóup", "tipo": "verbo",
    "ejemplo": { "en": "I hope you like it.", "es": "Espero que te guste." } },
  { "id": "en-basico-06-w48", "en": "guess", "es": "adivinar / suponer", "pron": "gués", "tipo": "verbo",
    "ejemplo": { "en": "I don't know. I guess so.", "es": "No sé. Supongo que sí." } },
  { "id": "en-basico-06-w49", "en": "I'm not sure.", "es": "No estoy seguro.", "pron": "áim nót shúr", "tipo": "expresion",
    "ejemplo": { "en": "Is the meeting today? I'm not sure.", "es": "¿La reunión es hoy? No estoy seguro." } },
  { "id": "en-basico-06-w50", "en": "No idea.", "es": "Ni idea.", "pron": "nóu aidía", "tipo": "expresion",
    "ejemplo": { "en": "Where are the keys? No idea.", "es": "¿Dónde están las llaves? Ni idea." } },
  { "id": "en-basico-06-w51", "en": "reason", "es": "razón, motivo", "pron": "rízon", "tipo": "sustantivo",
    "ejemplo": { "en": "What's the reason?", "es": "¿Cuál es el motivo?" } },
  { "id": "en-basico-06-w52", "en": "meaning", "es": "significado", "pron": "míning", "tipo": "sustantivo",
    "ejemplo": { "en": "I don't know the meaning of this word.", "es": "No sé el significado de esta palabra." } },
  { "id": "en-basico-06-w53", "en": "I don't know.", "es": "No sé.", "pron": "ái dóunt nóu", "tipo": "expresion",
    "ejemplo": { "en": "Where is Luis? I don't know.", "es": "¿Dónde está Luis? No sé." } },
  { "id": "en-basico-06-w54", "en": "I don't understand.", "es": "No entiendo.", "pron": "ái dóunt anderstánd", "tipo": "expresion",
    "ejemplo": { "en": "Sorry, I don't understand.", "es": "Perdón, no entiendo." } },
  { "id": "en-basico-06-w55", "en": "What do you mean?", "es": "¿Qué quieres decir?", "pron": "uát du iú mín", "tipo": "expresion",
    "ejemplo": { "en": "What do you mean? I don't understand.", "es": "¿Qué quieres decir? No entiendo." } },
  { "id": "en-basico-06-w56", "en": "How do you say it in English?", "es": "¿Cómo se dice en inglés?", "pron": "jáu du iú séi it in ínglish", "tipo": "expresion",
    "ejemplo": { "en": "Computadora. How do you say it in English?", "es": "Computadora. ¿Cómo se dice en inglés?" } },
  { "id": "en-basico-06-w57", "en": "How do you spell it?", "es": "¿Cómo se escribe?", "pron": "jáu du iú spél it", "tipo": "expresion",
    "ejemplo": { "en": "Isasi? How do you spell it?", "es": "¿Isasi? ¿Cómo se escribe?" } },
  { "id": "en-basico-06-w58", "en": "I think so.", "es": "Creo que sí.", "pron": "ái zínk sóu", "tipo": "expresion",
    "ejemplo": { "en": "Is the meeting at ten? I think so.", "es": "¿La reunión es a las diez? Creo que sí." } },
  { "id": "en-basico-06-w59", "en": "I don't think so.", "es": "Creo que no.", "pron": "ái dóunt zínk sóu", "tipo": "expresion",
    "ejemplo": { "en": "Is it difficult? I don't think so.", "es": "¿Es difícil? Creo que no." } },
  { "id": "en-basico-06-w60", "en": "Me too.", "es": "Yo también.", "pron": "mí tú", "tipo": "expresion",
    "ejemplo": { "en": "I like JavaScript. Me too.", "es": "Me gusta JavaScript. A mí también." } },
  { "id": "en-basico-06-w61", "en": "Me neither.", "es": "Yo tampoco.", "pron": "mí níder", "tipo": "expresion",
    "ejemplo": { "en": "I don't drink coffee. Me neither.", "es": "No tomo café. Yo tampoco." } },
  { "id": "en-basico-06-w62", "en": "Not really.", "es": "No mucho, en realidad no.", "pron": "nót ríli", "tipo": "expresion",
    "ejemplo": { "en": "Do you like soccer? Not really.", "es": "¿Te gusta el fútbol? No mucho." } }
]
