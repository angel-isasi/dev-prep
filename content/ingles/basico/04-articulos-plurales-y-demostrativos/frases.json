[
  { "id": "en-basico-04-f01", "en": "This is my new backpack.", "es": "Esta es mi mochila nueva." },
  { "id": "en-basico-04-f02", "en": "That's a red pen.", "es": "Ese es un lapicero rojo." },
  { "id": "en-basico-04-f03", "en": "These books are for the class.", "es": "Estos libros son para la clase." },
  { "id": "en-basico-04-f04", "en": "Those people are from Cusco.", "es": "Esas personas son de Cusco." },
  { "id": "en-basico-04-f05", "en": "She's an engineer at a big company.", "es": "Ella es ingeniera en una empresa grande." },
  { "id": "en-basico-04-f06", "en": "I'm a student at the university.", "es": "Soy estudiante de la universidad." },
  { "id": "en-basico-04-f07", "en": "The children are in the classroom.", "es": "Los niños están en el salón." },
  { "id": "en-basico-04-f08", "en": "Is this your pencil?", "es": "¿Este es tu lápiz?" },
  { "id": "en-basico-04-f09", "en": "Yes, it is. Thank you.", "es": "Sí, es mío. Gracias." },
  { "id": "en-basico-04-f10", "en": "Are those your keys?", "es": "¿Esas son tus llaves?" },
  { "id": "en-basico-04-f11", "en": "No, they aren't. My keys are black.", "es": "No. Mis llaves son negras." },
  { "id": "en-basico-04-f12", "en": "The board is white and the markers are blue.", "es": "La pizarra es blanca y los plumones son azules." },
  { "id": "en-basico-04-f13", "en": "These scissors are new.", "es": "Estas tijeras son nuevas." },
  { "id": "en-basico-04-f14", "en": "It's an easy question.", "es": "Es una pregunta fácil." },
  { "id": "en-basico-04-f15", "en": "That's a good question.", "es": "Esa es una buena pregunta." },
  { "id": "en-basico-04-f16", "en": "The men are in the office.", "es": "Los hombres están en la oficina." },
  { "id": "en-basico-04-f17", "en": "The women are engineers.", "es": "Las mujeres son ingenieras." },
  { "id": "en-basico-04-f18", "en": "My classmates are very friendly.", "es": "Mis compañeros de clase son muy amigables." },
  { "id": "en-basico-04-f19", "en": "This box is for the office.", "es": "Esta caja es para la oficina." },
  { "id": "en-basico-04-f20", "en": "Those boxes aren't heavy.", "es": "Esas cajas no son pesadas." },
  { "id": "en-basico-04-f21", "en": "The dictionary is on the desk.", "es": "El diccionario está en el escritorio." },
  { "id": "en-basico-04-f22", "en": "These are the new notebooks.", "es": "Estos son los cuadernos nuevos." },
  { "id": "en-basico-04-f23", "en": "What color is your bag?", "es": "¿De qué color es tu bolsa?" },
  { "id": "en-basico-04-f24", "en": "My bag is brown and black.", "es": "Mi bolsa es marrón con negro." },
  { "id": "en-basico-04-f25", "en": "The people in my class are nice.", "es": "La gente de mi clase es amable." },
  { "id": "en-basico-04-f26", "en": "Is that a map of Peru?", "es": "¿Ese es un mapa del Perú?" },
  { "id": "en-basico-04-f27", "en": "This is an important word.", "es": "Esta es una palabra importante." },
  { "id": "en-basico-04-f28", "en": "Those pencils are yellow, not red.", "es": "Esos lápices son amarillos, no rojos." },
  { "id": "en-basico-04-f29", "en": "These questions are easy.", "es": "Estas preguntas son fáciles." },
  { "id": "en-basico-04-f30", "en": "My feet are tired.", "es": "Tengo los pies cansados." }
]
