[
  { "id": "en-basico-02-f01", "en": "I'm very tired today.", "es": "Hoy estoy muy cansado." },
  { "id": "en-basico-02-f02", "en": "She's a developer from Lima.", "es": "Ella es desarrolladora de Lima." },
  { "id": "en-basico-02-f03", "en": "He isn't busy right now.", "es": "Él no está ocupado ahora." },
  { "id": "en-basico-02-f04", "en": "We're ready for the meeting.", "es": "Estamos listos para la reunión." },
  { "id": "en-basico-02-f05", "en": "They aren't from Peru.", "es": "Ellos no son de Perú." },
  { "id": "en-basico-02-f06", "en": "Are you happy here?", "es": "¿Estás contento aquí?" },
  { "id": "en-basico-02-f07", "en": "Yes, I am. Thank you.", "es": "Sí, lo estoy. Gracias." },
  { "id": "en-basico-02-f08", "en": "No, she isn't. She's sick.", "es": "No, no está. Está enferma." },
  { "id": "en-basico-02-f09", "en": "It's late. I'm sorry.", "es": "Es tarde. Lo siento." },
  { "id": "en-basico-02-f10", "en": "Is he a teacher?", "es": "¿Él es profesor?" },
  { "id": "en-basico-02-f11", "en": "Are they ready for the class?", "es": "¿Están listos para la clase?" },
  { "id": "en-basico-02-f12", "en": "I'm not nervous, I'm excited.", "es": "No estoy nervioso, estoy emocionado." },
  { "id": "en-basico-02-f13", "en": "My boss is very busy today.", "es": "Mi jefe está muy ocupado hoy." },
  { "id": "en-basico-02-f14", "en": "The class is boring.", "es": "La clase es aburrida." },
  { "id": "en-basico-02-f15", "en": "I'm bored and tired.", "es": "Estoy aburrido y cansado." },
  { "id": "en-basico-02-f16", "en": "Ana and Luis are friends.", "es": "Ana y Luis son amigos." },
  { "id": "en-basico-02-f17", "en": "We aren't late. We're early.", "es": "No llegamos tarde. Llegamos temprano." },
  { "id": "en-basico-02-f18", "en": "Is your answer correct?", "es": "¿Tu respuesta es correcta?" },
  { "id": "en-basico-02-f19", "en": "Are you free now?", "es": "¿Estás libre ahora?" },
  { "id": "en-basico-02-f20", "en": "She's smart and very friendly.", "es": "Ella es inteligente y muy amigable." },
  { "id": "en-basico-02-f21", "en": "He's shy, but he's very nice.", "es": "Él es tímido, pero es muy amable." },
  { "id": "en-basico-02-f22", "en": "They're worried about the project.", "es": "Están preocupados por el proyecto." },
  { "id": "en-basico-02-f23", "en": "Carlos isn't lazy. He's hardworking.", "es": "Carlos no es flojo. Es trabajador." },
  { "id": "en-basico-02-f24", "en": "Are you okay, María?", "es": "¿Estás bien, María?" },
  { "id": "en-basico-02-f25", "en": "Yes, I'm fine. I'm just tired.", "es": "Sí, estoy bien. Solo estoy cansado." },
  { "id": "en-basico-02-f26", "en": "The new job is great.", "es": "El nuevo trabajo es genial." },
  { "id": "en-basico-02-f27", "en": "My laptop is old, but it's good.", "es": "Mi laptop es vieja, pero es buena." },
  { "id": "en-basico-02-f28", "en": "We're interested in the job.", "es": "Estamos interesados en el trabajo." },
  { "id": "en-basico-02-f29", "en": "Is Tom available today?", "es": "¿Tom está disponible hoy?" },
  { "id": "en-basico-02-f30", "en": "I'm not sure. Is it wrong?", "es": "No estoy seguro. ¿Está mal?" },
  { "id": "en-basico-02-f31", "en": "Is the server down?", "es": "¿Está caído el servidor?", "trabajo": true },
  { "id": "en-basico-02-f32", "en": "I'm not ready for the demo.", "es": "No estoy listo para la demo.", "trabajo": true },
  { "id": "en-basico-02-f33", "en": "Sorry, I'm busy right now.", "es": "Perdón, ahora estoy ocupado.", "trabajo": true },
  { "id": "en-basico-02-f34", "en": "Are you free after lunch?", "es": "¿Estás libre después del almuerzo?", "trabajo": true },
  { "id": "en-basico-02-f35", "en": "The new design is very nice.", "es": "El nuevo diseño está muy bonito.", "trabajo": true }
]
