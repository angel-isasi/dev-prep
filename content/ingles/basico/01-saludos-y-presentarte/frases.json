[
  { "id": "en-basico-01-f01", "en": "Hello, my name is Ana.", "es": "Hola, me llamo Ana." },
  { "id": "en-basico-01-f02", "en": "Hi, I'm Carlos. I'm from Lima.", "es": "Hola, soy Carlos. Soy de Lima." },
  { "id": "en-basico-01-f03", "en": "Nice to meet you, Sarah.", "es": "Mucho gusto, Sarah." },
  { "id": "en-basico-01-f04", "en": "Nice to meet you too.", "es": "Igualmente, mucho gusto." },
  { "id": "en-basico-01-f05", "en": "I'm from Peru. I'm Peruvian.", "es": "Soy de Perú. Soy peruano." },
  { "id": "en-basico-01-f06", "en": "I'm a student from Cusco.", "es": "Soy un estudiante de Cusco." },
  { "id": "en-basico-01-f07", "en": "I'm a frontend developer.", "es": "Soy desarrollador frontend." },
  { "id": "en-basico-01-f08", "en": "Good morning, how are you?", "es": "Buenos días, ¿cómo estás?" },
  { "id": "en-basico-01-f09", "en": "I'm fine, thank you. And you?", "es": "Estoy bien, gracias. ¿Y tú?" },
  { "id": "en-basico-01-f10", "en": "What's your last name?", "es": "¿Cuál es tu apellido?" },
  { "id": "en-basico-01-f11", "en": "My last name is Torres.", "es": "Mi apellido es Torres." },
  { "id": "en-basico-01-f12", "en": "Where are you from, Tom?", "es": "¿De dónde eres, Tom?" },
  { "id": "en-basico-01-f13", "en": "I'm from the United States.", "es": "Soy de Estados Unidos." },
  { "id": "en-basico-01-f14", "en": "Excuse me, what's your name?", "es": "Disculpa, ¿cómo te llamas?" },
  { "id": "en-basico-01-f15", "en": "Sorry, what's your name again?", "es": "Perdón, ¿cómo te llamabas?" },
  { "id": "en-basico-01-f16", "en": "Thank you very much, María.", "es": "Muchas gracias, María." },
  { "id": "en-basico-01-f17", "en": "You're welcome. Have a nice day.", "es": "De nada. Que tengas un buen día." },
  { "id": "en-basico-01-f18", "en": "Goodbye, see you tomorrow.", "es": "Adiós, hasta mañana." },
  { "id": "en-basico-01-f19", "en": "Bye, see you later.", "es": "Chau, nos vemos luego." },
  { "id": "en-basico-01-f20", "en": "Good evening, my name is Luis.", "es": "Buenas noches, me llamo Luis." },
  { "id": "en-basico-01-f21", "en": "Good afternoon, nice to meet you.", "es": "Buenas tardes, mucho gusto." },
  { "id": "en-basico-01-f22", "en": "I'm an engineer from Chile.", "es": "Soy un ingeniero de Chile." },
  { "id": "en-basico-01-f23", "en": "My name is Tom. I'm American.", "es": "Me llamo Tom. Soy estadounidense." },
  { "id": "en-basico-01-f24", "en": "Hello, I'm Ana Torres, a developer from Lima.", "es": "Hola, soy Ana Torres, desarrolladora de Lima." },
  { "id": "en-basico-01-f25", "en": "My first name is María.", "es": "Mi nombre es María." },
  { "id": "en-basico-01-f26", "en": "My nationality is Peruvian.", "es": "Mi nacionalidad es peruana." },
  { "id": "en-basico-01-f27", "en": "Yes, please. Thank you.", "es": "Sí, por favor. Gracias." },
  { "id": "en-basico-01-f28", "en": "No, thanks. I'm fine.", "es": "No, gracias. Estoy bien." },
  { "id": "en-basico-01-f29", "en": "Hi, I'm Sarah. I'm a nurse.", "es": "Hola, soy Sarah. Soy enfermera." },
  { "id": "en-basico-01-f30", "en": "Good night, Ana. See you tomorrow.", "es": "Buenas noches, Ana. Hasta mañana." },
  { "id": "en-basico-01-f31", "en": "Hi, I'm Ana, the new frontend developer.", "es": "Hola, soy Ana, la nueva desarrolladora frontend.", "trabajo": true },
  { "id": "en-basico-01-f32", "en": "Nice to meet you all.", "es": "Mucho gusto a todos.", "trabajo": true },
  { "id": "en-basico-01-f33", "en": "I'm a junior developer from Lima.", "es": "Soy desarrollador junior de Lima.", "trabajo": true },
  { "id": "en-basico-01-f34", "en": "Good morning, everyone. I'm Tom, the tech lead.", "es": "Buenos días a todos. Soy Tom, el líder técnico.", "trabajo": true },
  { "id": "en-basico-01-f35", "en": "Welcome to the team, Ana!", "es": "¡Bienvenida al equipo, Ana!", "trabajo": true }
]
