[
  { "id": "en-basico-07-w01", "en": "routine", "es": "rutina", "pron": "rutín", "tipo": "sustantivo",
    "ejemplo": { "en": "My morning routine is very simple.", "es": "Mi rutina de la mañana es muy simple." } },
  { "id": "en-basico-07-w02", "en": "habit", "es": "hábito, costumbre", "pron": "jábit", "tipo": "sustantivo",
    "ejemplo": { "en": "Reading every day is a good habit.", "es": "Leer todos los días es un buen hábito." } },
  { "id": "en-basico-07-w03", "en": "schedule", "es": "horario / agenda", "pron": "skéyul", "tipo": "sustantivo",
    "ejemplo": { "en": "My schedule is very busy on Mondays.", "es": "Mi agenda está muy llena los lunes." } },
  { "id": "en-basico-07-w04", "en": "wake up", "es": "despertarse", "pron": "uéik áp", "tipo": "verbo",
    "formas": { "pasado": "woke up", "participio": "woken up" },
    "ejemplo": { "en": "I wake up at six.", "es": "Me despierto a las seis." } },
  { "id": "en-basico-07-w05", "en": "get up", "es": "levantarse", "pron": "guet áp", "tipo": "verbo",
    "formas": { "pasado": "got up", "participio": "gotten up" },
    "ejemplo": { "en": "She gets up early.", "es": "Ella se levanta temprano." } },
  { "id": "en-basico-07-w06", "en": "take a shower", "es": "ducharse", "pron": "téik a sháuer", "tipo": "expresion",
    "formas": { "pasado": "took a shower", "participio": "taken a shower" },
    "ejemplo": { "en": "I take a shower every morning.", "es": "Me ducho todas las mañanas." } },
  { "id": "en-basico-07-w07", "en": "brush your teeth", "es": "lavarse los dientes", "pron": "brásh iór tíz", "tipo": "expresion",
    "ejemplo": { "en": "I brush my teeth after breakfast.", "es": "Me lavo los dientes después del desayuno." } },
  { "id": "en-basico-07-w08", "en": "get dressed", "es": "vestirse", "pron": "guet drést", "tipo": "expresion",
    "formas": { "pasado": "got dressed", "participio": "gotten dressed" },
    "ejemplo": { "en": "I get dressed in five minutes.", "es": "Me visto en cinco minutos." } },
  { "id": "en-basico-07-w09", "en": "have breakfast", "es": "tomar desayuno", "pron": "jav brékfast", "tipo": "expresion",
    "formas": { "pasado": "had breakfast", "participio": "had breakfast" },
    "ejemplo": { "en": "We have breakfast at seven.", "es": "Tomamos desayuno a las siete." } },
  { "id": "en-basico-07-w10", "en": "have lunch", "es": "almorzar", "pron": "jav lánch", "tipo": "expresion",
    "formas": { "pasado": "had lunch", "participio": "had lunch" },
    "ejemplo": { "en": "I have lunch with my team.", "es": "Almuerzo con mi equipo." } },
  { "id": "en-basico-07-w11", "en": "have dinner", "es": "cenar", "pron": "jav díner", "tipo": "expresion",
    "formas": { "pasado": "had dinner", "participio": "had dinner" },
    "ejemplo": { "en": "They have dinner at nine.", "es": "Ellos cenan a las nueve." } },
  { "id": "en-basico-07-w12", "en": "commute", "es": "ir y volver del trabajo / viaje diario al trabajo", "pron": "komiút", "tipo": "verbo",
    "ejemplo": { "en": "I commute by bus.", "es": "Voy al trabajo en bus." } },
  { "id": "en-basico-07-w13", "en": "take the bus", "es": "tomar el bus", "pron": "téik de bás", "tipo": "expresion",
    "formas": { "pasado": "took the bus", "participio": "taken the bus" },
    "ejemplo": { "en": "He takes the bus to work.", "es": "Él toma el bus para ir al trabajo." } },
  { "id": "en-basico-07-w14", "en": "go to work", "es": "ir al trabajo", "pron": "góu tu uérk", "tipo": "expresion",
    "formas": { "pasado": "went to work", "participio": "gone to work" },
    "ejemplo": { "en": "I go to work at eight.", "es": "Voy al trabajo a las ocho." } },
  { "id": "en-basico-07-w15", "en": "get to work", "es": "llegar al trabajo", "pron": "guet tu uérk", "tipo": "expresion",
    "formas": { "pasado": "got to work", "participio": "gotten to work" },
    "ejemplo": { "en": "I get to work at nine.", "es": "Llego al trabajo a las nueve." } },
  { "id": "en-basico-07-w16", "en": "get home", "es": "llegar a casa", "pron": "guet jóum", "tipo": "expresion",
    "formas": { "pasado": "got home", "participio": "gotten home" },
    "ejemplo": { "en": "What time do you get home?", "es": "¿A qué hora llegas a casa?" } },
  { "id": "en-basico-07-w17", "en": "take a break", "es": "tomar un descanso", "pron": "téik a bréik", "tipo": "expresion",
    "formas": { "pasado": "took a break", "participio": "taken a break" },
    "ejemplo": { "en": "Let's take a break.", "es": "Tomemos un descanso." } },
  { "id": "en-basico-07-w18", "en": "cook dinner", "es": "cocinar la cena", "pron": "kúk díner", "tipo": "expresion",
    "ejemplo": { "en": "My dad cooks dinner on Fridays.", "es": "Mi papá cocina la cena los viernes." } },
  { "id": "en-basico-07-w19", "en": "do the dishes", "es": "lavar los platos", "pron": "dú de díshes", "tipo": "expresion",
    "formas": { "pasado": "did the dishes", "participio": "done the dishes" },
    "ejemplo": { "en": "I do the dishes after dinner.", "es": "Lavo los platos después de cenar." } },
  { "id": "en-basico-07-w20", "en": "do the laundry", "es": "lavar la ropa", "pron": "dú de lóndri", "tipo": "expresion",
    "formas": { "pasado": "did the laundry", "participio": "done the laundry" },
    "ejemplo": { "en": "I do the laundry on Saturdays.", "es": "Lavo la ropa los sábados." } },
  { "id": "en-basico-07-w21", "en": "do homework", "es": "hacer la tarea", "pron": "dú jóumuerk", "tipo": "expresion",
    "formas": { "pasado": "did homework", "participio": "done homework" },
    "ejemplo": { "en": "Students do homework at night.", "es": "Los estudiantes hacen la tarea en la noche." } },
  { "id": "en-basico-07-w22", "en": "go shopping", "es": "ir de compras", "pron": "góu shóping", "tipo": "expresion",
    "formas": { "pasado": "went shopping", "participio": "gone shopping" },
    "ejemplo": { "en": "We go shopping on Sundays.", "es": "Vamos de compras los domingos." } },
  { "id": "en-basico-07-w23", "en": "exercise", "es": "hacer ejercicio / ejercicio", "pron": "éksersais", "tipo": "verbo",
    "ejemplo": { "en": "I exercise three times a week.", "es": "Hago ejercicio tres veces por semana." } },
  { "id": "en-basico-07-w24", "en": "walk the dog", "es": "pasear al perro", "pron": "uók de dóg", "tipo": "expresion",
    "ejemplo": { "en": "She walks the dog every morning.", "es": "Ella pasea al perro todas las mañanas." } },
  { "id": "en-basico-07-w25", "en": "relax", "es": "relajarse, descansar", "pron": "riláks", "tipo": "verbo",
    "ejemplo": { "en": "I relax on Sunday afternoons.", "es": "Descanso los domingos en la tarde." } },
  { "id": "en-basico-07-w26", "en": "take a nap", "es": "tomar una siesta", "pron": "téik a náp", "tipo": "expresion",
    "formas": { "pasado": "took a nap", "participio": "taken a nap" },
    "ejemplo": { "en": "My grandpa takes a nap after lunch.", "es": "Mi abuelo toma una siesta después de almorzar." } },
  { "id": "en-basico-07-w27", "en": "go to bed", "es": "acostarse, irse a dormir", "pron": "góu tu béd", "tipo": "expresion",
    "formas": { "pasado": "went to bed", "participio": "gone to bed" },
    "ejemplo": { "en": "I go to bed at eleven.", "es": "Me acuesto a las once." } },
  { "id": "en-basico-07-w28", "en": "fall asleep", "es": "quedarse dormido", "pron": "fól aslíp", "tipo": "expresion",
    "formas": { "pasado": "fell asleep", "participio": "fallen asleep" },
    "ejemplo": { "en": "I fall asleep very fast.", "es": "Me quedo dormido muy rápido." } },
  { "id": "en-basico-07-w29", "en": "stay up late", "es": "quedarse despierto hasta tarde", "pron": "stéi ap léit", "tipo": "expresion",
    "ejemplo": { "en": "I stay up late on Fridays.", "es": "Me quedo despierto hasta tarde los viernes." } },
  { "id": "en-basico-07-w30", "en": "always", "es": "siempre", "pron": "ólueis", "tipo": "adverbio",
    "ejemplo": { "en": "I always check my email first.", "es": "Siempre reviso mi correo primero." } },
  { "id": "en-basico-07-w31", "en": "usually", "es": "normalmente, por lo general", "pron": "iúshuali", "tipo": "adverbio",
    "ejemplo": { "en": "We usually start at nine.", "es": "Normalmente empezamos a las nueve." } },
  { "id": "en-basico-07-w32", "en": "often", "es": "a menudo, seguido", "pron": "ófen", "tipo": "adverbio",
    "ejemplo": { "en": "He often works from home.", "es": "Él trabaja seguido desde casa." } },
  { "id": "en-basico-07-w33", "en": "sometimes", "es": "a veces", "pron": "sámtaims", "tipo": "adverbio",
    "ejemplo": { "en": "I sometimes study at night.", "es": "A veces estudio en la noche." } },
  { "id": "en-basico-07-w34", "en": "rarely", "es": "rara vez", "pron": "rérli", "tipo": "adverbio",
    "ejemplo": { "en": "She rarely takes a taxi.", "es": "Ella rara vez toma taxi." } },
  { "id": "en-basico-07-w35", "en": "hardly ever", "es": "casi nunca", "pron": "járdli éver", "tipo": "adverbio",
    "ejemplo": { "en": "I hardly ever watch TV.", "es": "Casi nunca veo televisión." } },
  { "id": "en-basico-07-w36", "en": "never", "es": "nunca", "pron": "néver", "tipo": "adverbio",
    "ejemplo": { "en": "I never work on Sundays.", "es": "Nunca trabajo los domingos." } },
  { "id": "en-basico-07-w37", "en": "every day", "es": "todos los días", "pron": "évri déi", "tipo": "expresion",
    "ejemplo": { "en": "I practice English every day.", "es": "Practico inglés todos los días." } },
  { "id": "en-basico-07-w38", "en": "every morning", "es": "todas las mañanas", "pron": "évri mórning", "tipo": "expresion",
    "ejemplo": { "en": "He runs every morning.", "es": "Él corre todas las mañanas." } },
  { "id": "en-basico-07-w39", "en": "every week", "es": "todas las semanas", "pron": "évri uík", "tipo": "expresion",
    "ejemplo": { "en": "We have a team meeting every week.", "es": "Tenemos una reunión de equipo todas las semanas." } },
  { "id": "en-basico-07-w40", "en": "once a week", "es": "una vez por semana", "pron": "uáns a uík", "tipo": "expresion",
    "ejemplo": { "en": "I call my grandma once a week.", "es": "Llamo a mi abuela una vez por semana." } },
  { "id": "en-basico-07-w41", "en": "twice a week", "es": "dos veces por semana", "pron": "tuáis a uík", "tipo": "expresion",
    "ejemplo": { "en": "She goes to the gym twice a week.", "es": "Ella va al gimnasio dos veces por semana." } },
  { "id": "en-basico-07-w42", "en": "three times a day", "es": "tres veces al día", "pron": "zrí táims a déi", "tipo": "expresion",
    "ejemplo": { "en": "I check my phone three times a day.", "es": "Reviso mi celular tres veces al día." } },
  { "id": "en-basico-07-w43", "en": "in the morning", "es": "en la mañana", "pron": "in de mórning", "tipo": "expresion",
    "ejemplo": { "en": "I study in the morning.", "es": "Estudio en la mañana." } },
  { "id": "en-basico-07-w44", "en": "in the afternoon", "es": "en la tarde", "pron": "in di afternún", "tipo": "expresion",
    "ejemplo": { "en": "We have meetings in the afternoon.", "es": "Tenemos reuniones en la tarde." } },
  { "id": "en-basico-07-w45", "en": "in the evening", "es": "en la noche (temprano, después del trabajo)", "pron": "in di ívning", "tipo": "expresion",
    "ejemplo": { "en": "I relax in the evening.", "es": "Descanso en la noche." } },
  { "id": "en-basico-07-w46", "en": "at night", "es": "en la noche (tarde, para dormir)", "pron": "at náit", "tipo": "expresion",
    "ejemplo": { "en": "I never drink coffee at night.", "es": "Nunca tomo café en la noche." } },
  { "id": "en-basico-07-w47", "en": "at noon", "es": "al mediodía", "pron": "at nún", "tipo": "expresion",
    "ejemplo": { "en": "We have lunch at noon.", "es": "Almorzamos al mediodía." } },
  { "id": "en-basico-07-w48", "en": "on weekends", "es": "los fines de semana", "pron": "on uíkends", "tipo": "expresion",
    "ejemplo": { "en": "I don't work on weekends.", "es": "No trabajo los fines de semana." } },
  { "id": "en-basico-07-w49", "en": "on weekdays", "es": "entre semana, de lunes a viernes", "pron": "on uíkdeis", "tipo": "expresion",
    "ejemplo": { "en": "I get up at six on weekdays.", "es": "Entre semana me levanto a las seis." } },
  { "id": "en-basico-07-w50", "en": "on Mondays", "es": "los lunes", "pron": "on mándeis", "tipo": "expresion",
    "ejemplo": { "en": "I go to the office on Mondays.", "es": "Voy a la oficina los lunes." } },
  { "id": "en-basico-07-w51", "en": "every night", "es": "todas las noches", "pron": "évri náit", "tipo": "expresion",
    "ejemplo": { "en": "I read for twenty minutes every night.", "es": "Leo veinte minutos todas las noches." } },
  { "id": "en-basico-07-w52", "en": "most days", "es": "casi todos los días", "pron": "móust déis", "tipo": "expresion",
    "ejemplo": { "en": "I work from home most days.", "es": "Trabajo desde casa casi todos los días." } },
  { "id": "en-basico-07-w53", "en": "next", "es": "después, a continuación / siguiente", "pron": "nékst", "tipo": "adverbio",
    "ejemplo": { "en": "Next, I check my email.", "es": "Después, reviso mi correo." } },
  { "id": "en-basico-07-w54", "en": "then", "es": "luego, después", "pron": "dén", "tipo": "conector",
    "ejemplo": { "en": "Then I have breakfast.", "es": "Luego tomo desayuno." } },
  { "id": "en-basico-07-w55", "en": "after that", "es": "después de eso", "pron": "áfter dát", "tipo": "conector",
    "ejemplo": { "en": "After that, I take the bus.", "es": "Después de eso, tomo el bus." } },
  { "id": "en-basico-07-w56", "en": "finally", "es": "al final, por último", "pron": "fáinali", "tipo": "adverbio",
    "ejemplo": { "en": "Finally, I go to bed.", "es": "Al final, me acuesto." } },
  { "id": "en-basico-07-w57", "en": "before", "es": "antes (de)", "pron": "bifór", "tipo": "preposicion",
    "ejemplo": { "en": "I read before bed.", "es": "Leo antes de dormir." } },
  { "id": "en-basico-07-w58", "en": "after", "es": "después (de)", "pron": "áfter", "tipo": "preposicion",
    "ejemplo": { "en": "I exercise after work.", "es": "Hago ejercicio después del trabajo." } },
  { "id": "en-basico-07-w59", "en": "day off", "es": "día libre", "pron": "déi óf", "tipo": "sustantivo",
    "ejemplo": { "en": "My day off is Friday.", "es": "Mi día libre es el viernes." } },
  { "id": "en-basico-07-w60", "en": "free time", "es": "tiempo libre", "pron": "frí táim", "tipo": "sustantivo",
    "ejemplo": { "en": "I code in my free time.", "es": "Programo en mi tiempo libre." } },
  { "id": "en-basico-07-w61", "en": "alarm", "es": "alarma, despertador", "pron": "alárm", "tipo": "sustantivo",
    "ejemplo": { "en": "My alarm rings at six.", "es": "Mi alarma suena a las seis." } }
]
