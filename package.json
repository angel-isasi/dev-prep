{
  "name": "dev-prep",
  "version": "0.1.0",
  "private": true,
  "description": "App local y offline para practicar JavaScript y React rumbo a un puesto frontend junior.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "start": "node server/index.js",
    "validar": "node scripts/validar-contenido.js",
    "test": "vitest run --config vitest.config.js",
    "validar:aprender": "node scripts/validar-aprender.js",
    "acceso-directo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/crear-acceso-directo.ps1",
    "arranque:activar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/arranque.ps1 activar",
    "arranque:quitar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/arranque.ps1 quitar",
    "exportar:movil": "node scripts/exportar-movil.js",
    "build:movil": "node scripts/exportar-movil.js && vite build --mode movil && node scripts/verificar-csp.js",
    "dev:movil": "node scripts/exportar-movil.js && vite --mode movil",
    "preview:movil": "vite preview --mode movil --port 4173",
    "aws:crear": "node scripts/aws-sync.js crear",
    "aws:borrar": "node scripts/aws-sync.js borrar",
    "aws:estado": "node scripts/aws-sync.js estado",
    "aws:rotar": "node scripts/aws-sync.js rotar",
    "validar:ingles": "node scripts/validar-ingles.js",
    "validar:predice": "node scripts/validar-predice.js"
  },
  "dependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "express": "^5.3.0",
    "jsdom": "^31.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "motion": "^14.14.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "react-use-measure": "^2.1.7",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0"
  }
}
