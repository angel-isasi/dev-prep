{
  "name": "dev-prep",
  "version": "0.1.0",
  "private": true,
  "description": "App local y offline para practicar JavaScript y React rumbo a un puesto frontend junior.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "start": "node server/index.js",
    "validar": "node scripts/validar-contenido.js",
    "test": "vitest run --config vitest.config.js",
    "validar:aprender": "node scripts/validar-aprender.js",
    "acceso-directo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/crear-acceso-directo.ps1"
  },
  "dependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "express": "^5.3.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vitest": "^5.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@vitejs/plugin-react": "^6.3.0",
    "canvas-confetti": "^1.9.4",
    "highlight.js": "^11.12.0",
    "motion": "^14.14.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "vite": "^8.3.8"
  }
